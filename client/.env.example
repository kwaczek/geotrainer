DEBUG=true
# Single admin (legacy format, still supported)
REACT_APP_ADMIN_USERNAME=your_admin_username
REACT_APP_ADMIN_PASSWORD=your_admin_password

# Multiple admins (preferred format)
# Comma-separated values for multiple admins
REACT_APP_ADMIN_USERNAMES=admin1,admin2,admin3
REACT_APP_ADMIN_PASSWORDS=pass1,pass2,pass3

REACT_APP_ADMIN_API_KEY=your_random_api_key_here 